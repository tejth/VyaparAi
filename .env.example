# VyaparAI configuration. Copy to .env and edit. No API keys or secrets are needed anywhere: everything is free and local.

# Where the local SQLite database is stored
# VYAPARAI_DB_PATH=data/vyaparai.db
# VYAPARAI_LOG_LEVEL=INFO

# AI Business Analyst backend: auto | ollama | huggingface | fallback
#   auto        Ollama if it is running, otherwise local Hugging Face, otherwise template fallback (default)
#   fallback    never use a language model
VYAPARAI_LLM_BACKEND=auto

# Ollama (free, runs on your computer): https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Free open-weight model downloaded once from the Hugging Face Hub and run locally (optional; needs transformers + torch)
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Seconds to wait for the language model before falling back to the template answer
VYAPARAI_LLM_TIMEOUT=120
